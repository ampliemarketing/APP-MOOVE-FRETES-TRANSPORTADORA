// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id                    String    @id @default(uuid()) @db.Uuid
  email                 String    @unique
  name                  String
  phone                 String?
  cpf                   String?
  cnpj                  String?
  user_type             String
  avatar_url            String?
  bio                   String?
  status                String
  verification_status   String
  email_verified        Boolean   @default(false)
  is_admin              Boolean   @default(false)
  is_online             Boolean   @default(false)
  last_seen             DateTime? @db.Timestamptz
  last_login_at         DateTime? @db.Timestamptz
  rating                Decimal   @default(0.0)
  total_ratings         Int       @default(0)
  total_freights        Int       @default(0)
  completed_freights    Int       @default(0)
  cancelled_freights    Int       @default(0)
  total_distance_km     Decimal   @default(0.0)
  total_earnings        Decimal   @default(0.0)
  followers_count       Int       @default(0)
  following_count       Int       @default(0)
  push_token            String?
  push_token_updated_at DateTime? @db.Timestamptz
  city                  String?
  state                 String?
  metadata              Json?
  created_at            DateTime  @default(now()) @db.Timestamptz
  updated_at            DateTime  @updatedAt @db.Timestamptz

  @@map("profiles")
}

model Company {
  id                     String    @id @default(uuid()) @db.Uuid
  user_id                String    @unique @db.Uuid
  company_name           String
  trading_name           String?
  company_type           String
  company_subtype        String
  cnpj                   String?
  is_individual          Boolean   @default(false)
  main_cpf               String?
  state_registration     String?
  municipal_registration String?
  email                  String?
  phone                  String?
  website                String?
  logo_url               String?
  description            String?
  address                Json?
  certifications         Json?
  fleet_size             Int?
  operating_states       String[]
  representative_name    String?
  representative_cpf     String?
  representative_rg      String?
  representative_phone   String?
  representative_email   String?
  representative_role    String?
  representative_cnh     String?
  rntrc                  String?
  rntrc_expiry           DateTime? @db.Date
  rntrc_status           String
  ocb_registration       String?
  status                 String
  verification_status    String
  rating                 Decimal   @default(0.0)
  active_freights        Int       @default(0)
  completed_freights     Int       @default(0)
  review_count           Int       @default(0)
  created_at             DateTime  @default(now()) @db.Timestamptz
  updated_at             DateTime  @updatedAt @db.Timestamptz

  @@map("companies")
}

model Driver {
  id                          String    @id @default(uuid()) @db.Uuid
  user_id                     String    @unique @db.Uuid
  name                        String
  phone                       String?
  cpf                         String?
  rg                          String?
  birth_date                  DateTime? @db.Date
  cnh                         String?
  cnh_category                String
  cnh_expiry                  DateTime? @db.Date
  rntrc                       String?
  rntrc_expiry                DateTime? @db.Date
  rntrc_status                String
  driver_classification       String
  payment_account_holder      String
  payment_account_holder_name String?
  payment_account_holder_doc  String?
  profile_image               String?
  vehicle_type                String?
  vehicle_plate               String?
  vehicle_model               String?
  vehicle_year                String?
  vehicle_capacity            Decimal?
  renavam                     String?
  antt_vehicle                String?
  vehicle_types               String[]
  body_types                  String[]
  trailer_type                String?
  experience_years            Int?
  specializations             String[]
  current_location            Json?
  address                     Json?
  available                   Boolean   @default(true)
  availability_expires_at     DateTime? @db.Timestamptz
  rating                      Decimal   @default(0.0)
  punctuality                 Decimal   @default(0.0)
  completed_trips             Int       @default(0)
  created_at                  DateTime  @default(now()) @db.Timestamptz
  updated_at                  DateTime  @updatedAt @db.Timestamptz

  @@map("drivers")
}

model Freight {
  id                       String    @id @default(uuid()) @db.Uuid
  freight_code             String?   @unique
  title                    String?
  description              String?
  publisher_id             String    @db.Uuid
  publisher_phone          String?
  created_by               String?   @db.Uuid
  status                   String
  visibility               String
  origin_city              String?
  origin_state             String?
  origin_address           String?
  origin_cep               String?
  origin_coordinates       Json?
  destination_city         String?
  destination_state        String?
  destination_address      String?
  destination_cep          String?
  destination_coordinates  Json?
  cargo_type               String?
  weight_kg                Decimal?
  volume_m3                Decimal?
  quantity                 String?
  vehicle_types            String[]
  body_types               String[]
  requirements             Json?
  value_estimate           Decimal?
  distance_km              Decimal?
  duration_hours           Decimal?
  is_urgent                Boolean   @default(false)
  is_fractioned            Boolean   @default(false)
  is_full_load             Boolean   @default(false)
  pickup_date              DateTime? @db.Timestamptz
  delivery_date            DateTime? @db.Timestamptz
  deadline_date            DateTime? @db.Timestamptz
  scheduled_date           DateTime? @db.Timestamptz
  expires_at               DateTime? @db.Timestamptz
  accepted_driver_id       String?   @db.Uuid
  accepted_driver_name     String?
  views_count              Int       @default(0)
  operation_type           String?
  load_classification      String?
  piso_minimo_valor        Decimal?
  piso_minimo_calculado_em DateTime? @db.Timestamptz
  abaixo_do_piso           Boolean   @default(false)
  ciot_status              String
  vale_pedagio_status      String
  payment_account_type     String?
  advance_payment_percent  Decimal?
  metadata                 Json?
  created_at               DateTime  @default(now()) @db.Timestamptz
  updated_at               DateTime  @updatedAt @db.Timestamptz
  published_at             DateTime? @db.Timestamptz
  completed_at             DateTime? @db.Timestamptz
  cancelled_at             DateTime? @db.Timestamptz
  cancellation_reason      String?

  @@map("freights")
}

model Conversation {
  id                      String    @id @default(uuid()) @db.Uuid
  participant1_id         String    @db.Uuid
  participant2_id         String    @db.Uuid
  source                  String
  source_id               String?
  freight_id              String?   @db.Uuid
  origin_city             String?
  origin_state            String?
  destination_city        String?
  destination_state       String?
  last_message_at         DateTime? @db.Timestamptz
  last_message_content    String?
  last_message_sender_id  String?   @db.Uuid
  last_message_read       Boolean   @default(false)
  deleted_by_participant1 Boolean   @default(false)
  deleted_by_participant2 Boolean   @default(false)
  is_pinned               Boolean   @default(false)
  is_muted                Boolean   @default(false)
  metadata                Json?
  created_at              DateTime  @default(now()) @db.Timestamptz

  @@map("conversations")
}

model Message {
  id              String    @id @default(uuid()) @db.Uuid
  conversation_id String    @db.Uuid
  sender_id       String    @db.Uuid
  content         String
  message_type    String
  attachments     Json?
  is_read         Boolean   @default(false)
  read_at         DateTime? @db.Timestamptz
  reported        Boolean   @default(false)
  metadata        Json?
  created_at      DateTime  @default(now()) @db.Timestamptz

  @@map("messages")
}

model Notification {
  id           String    @id @default(uuid()) @db.Uuid
  user_id      String    @db.Uuid
  type         String
  title        String
  message      String
  icon         String?
  related_id   String?   @db.Uuid
  related_type String?
  action_url   String?
  action_label String?
  is_read      Boolean   @default(false)
  read_at      DateTime? @db.Timestamptz
  metadata     Json?
  created_at   DateTime  @default(now()) @db.Timestamptz

  @@map("notifications")
}

model Rating {
  id                     String    @id @default(uuid()) @db.Uuid
  freight_id             String?   @db.Uuid
  freight_code           String?
  target_id              String    @db.Uuid
  target_name            String?
  target_type            String?
  evaluator_id           String    @db.Uuid
  evaluator_name         String?
  evaluator_type         String?
  overall_rating         Decimal
  punctuality_rating     Decimal?
  communication_rating   Decimal?
  professionalism_rating Decimal?
  categories             Json?
  comment                String?
  reported               Boolean   @default(false)
  report_reason          String?
  status                 String
  created_at             DateTime  @default(now()) @db.Timestamptz
  updated_at             DateTime  @updatedAt @db.Timestamptz

  @@map("ratings")
}

model UserFollow {
  id           String   @id @default(uuid()) @db.Uuid
  follower_id  String   @db.Uuid
  following_id String   @db.Uuid
  created_at   DateTime @default(now()) @db.Timestamptz

  @@map("user_follows")
}

model SocialPost {
  id             String   @id @default(uuid()) @db.Uuid
  author_id      String   @db.Uuid
  content        String
  type           String
  visibility     String
  images         String[]
  attachments    Json?
  likes_count    Int      @default(0)
  comments_count Int      @default(0)
  shares_count   Int      @default(0)
  tags           String[]
  location       String?
  metadata       Json?
  created_at     DateTime @default(now()) @db.Timestamptz
  updated_at     DateTime @updatedAt @db.Timestamptz

  @@map("social_posts")
}

model SocialLike {
  id         String   @id @default(uuid()) @db.Uuid
  post_id    String   @db.Uuid
  user_id    String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz

  @@map("social_likes")
